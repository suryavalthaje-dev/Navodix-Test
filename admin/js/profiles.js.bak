(function(){
  'use strict';
  const supabase = window.navodixSupabase;
  const $ = id => document.getElementById(id);
  const params = new URLSearchParams(window.location.search);
  const requirementId = params.get('requirement');
  let profiles = [], requirement = null, requirements = [], saving = false, keepExistingResume = true, selectedExistingResume = false, allExistingProfiles = [], profileToAssociate = null;
  const esc = v => String(v ?? '').replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
  function message(text,type=''){ $('profilesMessage').textContent=text||''; $('profilesMessage').className='admin-message'+(type?' '+type:''); }
  function formMessage(text,type=''){ $('profileFormMessage').textContent=text||''; $('profileFormMessage').className='admin-message'+(type?' '+type:''); }
  function showModal(){ $('profileModal').classList.remove('hidden'); $('profileModal').setAttribute('aria-hidden','false'); document.body.classList.add('modal-open'); }
  function closeModal(){ if(saving)return; $('profileModal').classList.add('hidden'); $('profileModal').setAttribute('aria-hidden','true'); document.body.classList.remove('modal-open'); }
  function statusClass(s){ return ({'Available':'status-active','Considering':'status-warning','On Hold':'status-warning','Not Available':'status-danger','Not Suitable':'status-danger','Do Not Contact':'status-danger','Archived':'status-muted'})[s]||'status-info'; }
  function resetForm(){ $('profileForm').reset(); $('profileModalTitle').textContent='Add Profile'; $('profileId').value=''; $('profileAssociationRequirementId').value=requirementId||''; $('profileStatus').value='New'; $('profileSource').value=''; $('profileRequirement').value=requirementId||''; $('existingProfileNotice').classList.add('hidden'); $('resumeReplaceNotice').classList.add('hidden'); $('resumeFile').value=''; $('existingResumeFilename').textContent=''; $('existingResumeFilename').title=''; $('existingResumeFilename').classList.add('hidden'); $('resumeHelp').textContent='Select a resume from your computer. Maximum 5 MB. PDF, DOC or DOCX.'; keepExistingResume=true; selectedExistingResume=false; formMessage(''); toggleReferrerFields(); }
  function populateRequirementOptions(selectedId=''){ const select=$('profileRequirement'); const previous=selectedId||select.value||''; select.innerHTML='<option value="">Select Requirement</option>'+requirements.map(r=>`<option value="${esc(r.id)}">${esc(r.job_code||'')} — ${esc(r.title||'')}${r.status?` (${esc(r.status)})`:''}</option>`).join(''); select.value=previous; $('profileAssociationRequirementId').value=select.value||''; }
  function toggleReferrerFields(){ const source=$('profileSource').value; const show=['Refer a Candidate','Employee Referral','Client Reference'].includes(source); $('referrerFields').classList.toggle('hidden',!show); if(!show){$('referrerName').value='';$('referrerMobile').value='';$('referrerEmail').value='';} }
  function openAdd(){ resetForm(); populateRequirementOptions(requirementId||''); if(requirement){ $('profileRequirement').value=requirement.id; $('profileAssociationRequirementId').value=requirement.id; $('existingProfileNotice').innerHTML='<strong>Requirement:</strong> '+esc(requirement.job_code)+' — '+esc(requirement.title)+'<br><small>This profile will be automatically associated with this requirement when saved.</small>'; $('existingProfileNotice').classList.remove('hidden'); } showModal(); $('fullName').focus(); }
  async function loadRequirement(){ if(!requirementId)return; const {data,error}=await supabase.from('jobs').select('id,job_code,title,status').eq('id',requirementId).maybeSingle(); if(error)throw error; requirement=data; if(data){ $('associateExistingButton').classList.remove('hidden'); $('requirementContext').innerHTML='<span class="context-chip"><i class="fa-solid fa-briefcase"></i> '+esc(data.job_code)+' — '+esc(data.title)+'</span><a class="btn btn-outline btn-small" href="recruitment.html">Back to Requirements</a>'; $('requirementContext').classList.remove('hidden'); } }
  async function loadRequirements(){ const {data,error}=await supabase.from('jobs').select('id,job_code,title,status').order('title',{ascending:true}); if(error)throw error; requirements=data||[]; populateRequirementOptions(requirementId||''); }
  async function loadProfiles(){ message('Loading profiles…'); let q=supabase.from('profiles').select('id,profile_number,full_name,email,phone,current_location,total_experience,current_job_title,current_company,availability,status,created_at').order('created_at',{ascending:false}); if(requirementId) q=q.in('id', (await getRequirementProfileIds())); const {data,error}=await q; if(error)throw error; profiles=data||[]; await attachSourcesAndAssociations(); render(); message(profiles.length?'':'No profiles found.'); }
  async function getRequirementProfileIds(){ const {data,error}=await supabase.from('profile_requirement_associations').select('profile_id').eq('requirement_id',requirementId); if(error)throw error; return (data||[]).map(x=>x.profile_id).length?(data||[]).map(x=>x.profile_id):['00000000-0000-0000-0000-000000000000']; }
  async function attachSourcesAndAssociations(){ const ids=profiles.map(p=>p.id); if(!ids.length)return; const [s,a]=await Promise.all([supabase.from('profile_sources').select('profile_id,source').in('profile_id',ids).eq('is_primary',true),supabase.from('profile_requirement_associations').select('profile_id,requirement_id,status').in('profile_id',ids)]); if(s.error)throw s.error;if(a.error)throw a.error; const sourceMap=Object.fromEntries((s.data||[]).map(x=>[x.profile_id,x.source])); const assocMap={}; (a.data||[]).forEach(x=>{(assocMap[x.profile_id]??=[]).push(x)}); profiles.forEach(p=>{p.source=sourceMap[p.id]||'—';p.associations=assocMap[p.id]||[]}); }
  function filtered(){ const term=$('profileSearch').value.trim().toLowerCase(), status=$('profileStatusFilter').value, source=$('profileSourceFilter').value; return profiles.filter(p=>(!term||[p.profile_number,p.full_name,p.email,p.phone,p.current_location,p.current_job_title].some(v=>String(v||'').toLowerCase().includes(term)))&&(!status||p.status===status)&&(!source||p.source===source)); }
  function render(){ const body=$('profilesTableBody'), empty=$('emptyProfiles'), rows=filtered(); body.innerHTML=rows.map(p=>{const assoc=requirementId? p.associations?.find(a=>a.requirement_id===requirementId):p.associations?.[0];return `<tr><td><div class="profile-name-cell"><strong>${esc(p.full_name)}</strong><span>${esc(p.profile_number)} · ${esc(p.current_job_title||'')}</span></div></td><td>${esc(p.current_location||'—')}</td><td>${esc(p.total_experience||'—')}</td><td><span class="source-chip">${esc(p.source)}</span></td><td><span class="status-pill ${statusClass(p.status)}">${esc(p.status)}</span></td><td>${assoc?`<span class="association-badge"><i class="fa-solid fa-link"></i> ${esc(assoc.status||'Associated')}</span>`:'—'}</td><td><div class="row-actions"><button class="icon-button" data-action="edit" data-id="${p.id}" title="Edit profile"><i class="fa-solid fa-pen-to-square"></i></button>${!requirementId?`<button class="icon-button" data-action="associate" data-id="${p.id}" title="Associate with requirement"><i class="fa-solid fa-link"></i></button>`:''}</div></td></tr>`}).join(''); empty.classList.toggle('hidden',rows.length!==0); body.parentElement.classList.toggle('hidden',rows.length===0); }
  async function callProfileFunction(formData){ const {data:{session}}=await supabase.auth.getSession(); if(!session)throw new Error('Your session has expired. Please sign in again.'); const response=await fetch(window.NAVODIX_SUPABASE_URL+'/functions/v1/profile-management',{method:'POST',headers:{Authorization:'Bearer '+session.access_token},body:formData}); const payload=await response.json().catch(()=>({})); if(!response.ok)throw new Error(payload.error||payload.message||'Profile operation failed.'); return payload; }
  function formDataFromForm(){ const fd=new FormData(); $('profileAssociationRequirementId').value=$('profileRequirement').value||''; const fields={profile_id:$('profileId').value,requirement_id:$('profileAssociationRequirementId').value,full_name:$('fullName').value.trim(),email:$('email').value.trim(),phone:$('phone').value.trim(),alternate_phone:$('alternatePhone').value.trim(),current_location:$('currentLocation').value.trim(),availability:$('availability').value.trim(),current_job_title:$('currentJobTitle').value.trim(),current_company:$('currentCompany').value.trim(),total_experience:$('totalExperience').value.trim(),notice_period:$('noticePeriod').value.trim(),current_ctc:$('currentCtc').value.trim(),expected_ctc:$('expectedCtc').value.trim(),highest_qualification:$('highestQualification').value.trim(),specialization:$('specialization').value.trim(),graduation_year:$('graduationYear').value||'',linkedin_url:$('linkedinUrl').value.trim(),status:$('profileStatus').value,source:$('profileSource').value,source_details:$('sourceDetails').value.trim(),referrer_name:$('referrerName').value.trim(),referrer_mobile:$('referrerMobile').value.trim(),referrer_email:$('referrerEmail').value.trim(),skills:$('skills').value.trim(),additional_information:$('additionalInformation').value.trim(),replace_resume:String(!keepExistingResume)}; Object.entries(fields).forEach(([k,v])=>fd.append(k,v)); const file=$('resumeFile').files[0]; if(file)fd.append('resume',file,file.name); return fd; }
  async function saveProfile(e){ e.preventDefault(); if(saving)return; if(!$('fullName').value.trim()||!$('phone').value.trim()||!$('profileSource').value){formMessage('Full Name, Phone and Source are required.','error');return;} const file=$('resumeFile').files[0]; if(file){if(file.size>5*1024*1024){formMessage('Resume must be 5 MB or smaller.','error');return;}if(!/\.(pdf|doc|docx)$/i.test(file.name)){formMessage('Resume must be PDF, DOC or DOCX.','error');return;}} saving=true;$('saveProfileButton').disabled=true;$('saveProfileButton').innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Saving…';formMessage('Saving profile…');try{const result=await callProfileFunction(formDataFromForm());if(result.duplicate&&result.profile_id&&!$('profileId').value){formMessage('An existing profile was found. Please use the existing profile instead of creating a duplicate.','error');return;} if(result.resume_existing&&!result.resume_replaced){ $('resumeReplaceNotice').classList.remove('hidden'); formMessage('An existing resume is already stored. Choose Keep Existing Resume or Replace with New Resume.',''); return;} formMessage(result.associated?'Successfully saved and automatically associated with the requirement.':'Successfully saved.','success'); message(result.associated?'Profile saved and automatically associated with the requirement.':'Profile saved successfully.','success'); saving=false; $('saveProfileButton').disabled=false; $('saveProfileButton').innerHTML='<i class="fa-solid fa-floppy-disk"></i> Save Profile'; await loadProfiles();}catch(err){console.error(err);formMessage(err.message||String(err),'error');}finally{saving=false;$('saveProfileButton').disabled=false;$('saveProfileButton').innerHTML='<i class="fa-solid fa-floppy-disk"></i> Save Profile';}}
  async function editProfile(id){ const {data,error}=await supabase.from('profiles').select('*').eq('id',id).single(); if(error)throw error; resetForm(); $('profileId').value=data.id;$('fullName').value=data.full_name||'';$('email').value=data.email||'';$('phone').value=data.phone||'';$('alternatePhone').value=data.alternate_phone||'';$('currentLocation').value=data.current_location||'';$('availability').value=data.availability||'';$('currentJobTitle').value=data.current_job_title||'';$('currentCompany').value=data.current_company||'';$('totalExperience').value=data.total_experience||'';$('noticePeriod').value=data.notice_period||'';$('currentCtc').value=data.current_ctc||'';$('expectedCtc').value=data.expected_ctc||'';$('highestQualification').value=data.highest_qualification||'';$('specialization').value=data.specialization||'';$('graduationYear').value=data.graduation_year||'';$('linkedinUrl').value=data.linkedin_url||'';$('skills').value=data.skills||''; if(data.resume_file_name){$('existingResumeFilename').textContent=data.resume_file_name;$('existingResumeFilename').title=data.resume_file_name;$('existingResumeFilename').classList.remove('hidden');}$('additionalInformation').value=data.additional_information||'';$('profileStatus').value=data.status||'New'; populateRequirementOptions(requirementId||''); $('profileRequirement').value=requirementId||''; $('profileAssociationRequirementId').value=requirementId||''; const {data:src}=await supabase.from('profile_sources').select('source,source_details,referrer_name,referrer_mobile,referrer_email').eq('profile_id',id).eq('is_primary',true).maybeSingle(); if(src){$('profileSource').value=src.source||'';$('sourceDetails').value=src.source_details||'';$('referrerName').value=src.referrer_name||'';$('referrerMobile').value=src.referrer_mobile||'';$('referrerEmail').value=src.referrer_email||'';toggleReferrerFields();} $('profileModalTitle').textContent='Edit Profile'; if(requirement){$('existingProfileNotice').innerHTML='<strong>Requirement:</strong> '+esc(requirement.job_code)+' — '+esc(requirement.title)+'<br><small>Saving will keep this profile associated with the requirement.</small>';$('existingProfileNotice').classList.remove('hidden');} showModal(); }
  function renderExistingProfiles(){ const body=$('existingProfileTableBody'); const term=$('existingProfileSearch').value.trim().toLowerCase(); const rows=allExistingProfiles.filter(p=>!term||[p.profile_number,p.full_name,p.email,p.phone,p.current_location].some(v=>String(v||'').toLowerCase().includes(term))); body.innerHTML=rows.map(p=>`<tr><td><div class="profile-name-cell"><strong>${esc(p.full_name)}</strong><span>${esc(p.profile_number)} · ${esc(p.current_job_title||'')}</span></div></td><td>${esc(p.current_location||'—')}</td><td><span class="status-pill ${statusClass(p.status)}">${esc(p.status)}</span></td><td><button class="btn btn-primary btn-small" data-existing-associate="${p.id}"><i class="fa-solid fa-link"></i> Associate</button></td></tr>`).join(''); if(!rows.length) $('existingProfileMessage').textContent='No matching profiles found.'; else $('existingProfileMessage').textContent=''; }
  async function openExistingProfileModal(){ if(!requirementId||!requirement)return; $('existingProfileSearch').value=''; $('existingProfileMessage').textContent='Loading profiles…'; $('existingProfileModal').classList.remove('hidden'); $('existingProfileModal').setAttribute('aria-hidden','false'); document.body.classList.add('modal-open'); const {data,error}=await supabase.from('profiles').select('id,profile_number,full_name,email,phone,current_location,current_job_title,status').order('full_name'); if(error){$('existingProfileMessage').textContent=error.message;return;} const {data:assoc,error:assocError}=await supabase.from('profile_requirement_associations').select('profile_id').eq('requirement_id',requirementId); if(assocError){$('existingProfileMessage').textContent=assocError.message;return;} const associatedIds=new Set((assoc||[]).map(x=>x.profile_id)); allExistingProfiles=(data||[]).filter(p=>!associatedIds.has(p.id)); renderExistingProfiles(); }
  function closeExistingProfileModal(){ $('existingProfileModal').classList.add('hidden'); $('existingProfileModal').setAttribute('aria-hidden','true'); document.body.classList.remove('modal-open'); }
  function openAssociateRequirementModal(id){ const p=profiles.find(x=>x.id===id); profileToAssociate={id,name:p?.full_name||'Profile'}; $('associateRequirementProfileName').value=p?.full_name ? `${p.full_name} (${p.profile_number||''})` : id; $('associateRequirementSelect').innerHTML='<option value="">Select Requirement</option>'+requirements.map(r=>`<option value="${esc(r.id)}">${esc(r.job_code||'')} — ${esc(r.title||'')}${r.status?` (${esc(r.status)})`:''}</option>`).join(''); $('associateRequirementSelect').value=''; $('associateRequirementMessage').textContent=''; $('associateRequirementMessage').className='admin-message'; $('associateRequirementModal').classList.remove('hidden'); $('associateRequirementModal').setAttribute('aria-hidden','false'); document.body.classList.add('modal-open'); }
  function closeAssociateRequirementModal(){ profileToAssociate=null; $('associateRequirementModal').classList.add('hidden'); $('associateRequirementModal').setAttribute('aria-hidden','true'); document.body.classList.remove('modal-open'); }
  async function saveAssociateRequirement(){ if(!profileToAssociate)return; const reqId=$('associateRequirementSelect').value; if(!reqId){ $('associateRequirementMessage').textContent='Please select a requirement.'; $('associateRequirementMessage').className='admin-message error'; return; } const btn=$('saveAssociateRequirementButton'); btn.disabled=true; $('associateRequirementMessage').textContent='Associating profile…'; $('associateRequirementMessage').className='admin-message'; try{ const {error}=await supabase.from('profile_requirement_associations').upsert({profile_id:profileToAssociate.id,requirement_id:reqId,status:'New',association_type:'manual'},{onConflict:'profile_id,requirement_id'}); if(error)throw error; $('associateRequirementMessage').textContent='Profile associated successfully with the requirement.'; $('associateRequirementMessage').className='admin-message success'; message('Profile associated successfully with the requirement.','success'); await loadProfiles(); setTimeout(closeAssociateRequirementModal,500); }catch(err){ $('associateRequirementMessage').textContent=err.message||String(err); $('associateRequirementMessage').className='admin-message error'; } finally { btn.disabled=false; } }
  async function associateProfile(id){ if(requirementId){ const {error}=await supabase.from('profile_requirement_associations').upsert({profile_id:id,requirement_id:requirementId,status:'New',association_type:'manual'},{onConflict:'profile_id,requirement_id'}); if(error)throw error; message('Profile associated successfully with the requirement.','success'); await loadProfiles(); return; } openAssociateRequirementModal(id); }

  $('profileRequirement').addEventListener('change',()=>{ $('profileAssociationRequirementId').value=$('profileRequirement').value||''; }); $('profileSource').addEventListener('change',toggleReferrerFields); $('resumeFile').addEventListener('change',()=>{selectedExistingResume=Boolean($('profileId').value); if(selectedExistingResume&&$('resumeFile').files[0])$('resumeReplaceNotice').classList.remove('hidden');}); $('keepResumeButton').addEventListener('click',()=>{keepExistingResume=true;$('resumeFile').value='';$('resumeReplaceNotice').classList.add('hidden');formMessage('Existing resume will be kept.','');}); $('replaceResumeButton').addEventListener('click',()=>{keepExistingResume=false;$('resumeReplaceNotice').classList.add('hidden');formMessage('New resume will replace the existing resume when saved.','');}); $('addProfileButton').addEventListener('click',openAdd); $('closeProfileModal').addEventListener('click',closeModal); $('cancelProfileButton').addEventListener('click',closeModal); $('profileForm').addEventListener('submit',saveProfile); $('profileSearch').addEventListener('input',render); $('profileStatusFilter').addEventListener('change',render); $('profileSourceFilter').addEventListener('change',render); $('refreshProfilesButton').addEventListener('click',()=>loadProfiles()); $('associateExistingButton').addEventListener('click',openExistingProfileModal); $('closeExistingProfileModal').addEventListener('click',closeExistingProfileModal); $('closeAssociateRequirementModal').addEventListener('click',closeAssociateRequirementModal); $('cancelAssociateRequirementButton').addEventListener('click',closeAssociateRequirementModal); $('saveAssociateRequirementButton').addEventListener('click',saveAssociateRequirement); $('existingProfileSearch').addEventListener('input',renderExistingProfiles); $('existingProfileTableBody').addEventListener('click',async e=>{const b=e.target.closest('[data-existing-associate]');if(!b)return; b.disabled=true; try{await associateProfile(b.dataset.existingAssociate);}catch(err){$('existingProfileMessage').textContent=err.message||String(err);}finally{b.disabled=false;}}); $('profilesTableBody').addEventListener('click',async e=>{const b=e.target.closest('[data-action]');if(!b)return;try{if(b.dataset.action==='edit')await editProfile(b.dataset.id);else if(b.dataset.action==='associate')await associateProfile(b.dataset.id);}catch(err){message(err.message||String(err),'error');}}); $('profileModal').addEventListener('click',e=>{if(e.target===$('profileModal'))return;});
  document.addEventListener('DOMContentLoaded',async()=>{const allowed=await window.navodixAdminReady;if(allowed===false)return;try{await loadRequirement();await loadRequirements();await loadProfiles();}catch(err){console.error(err);message('Could not load Profiles Management. Run the Profile Management database migration and deploy the profile-management Edge Function first.','error');}});
})();
