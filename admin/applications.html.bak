<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<meta content="noindex,nofollow,noarchive" name="robots"/>
<title>Applications | Navodix Careers Admin</title>
<link href="../assets/images/favicon.png" rel="icon" type="image/png"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<link href="css/admin.css?v=31" rel="stylesheet"/>

<style id="applications-list-ui-spec">
/* Applications List — visual alignment with Action Items list specification.
   UI-only overrides. No application logic or other page styles changed. */
body.admin-app-page { font-family:'Segoe UI',system-ui,-apple-system,sans-serif; }
.admin-main > .admin-container { max-width:1200px; width:calc(100% - 40px); }
.admin-page-heading { margin-bottom:10px !important; }
.admin-page-heading h1 { font-family:'Segoe UI',system-ui,-apple-system,sans-serif !important; font-size:32px !important; line-height:1.15 !important; color:#071B4D !important; font-weight:700 !important; }
.jobs-heading-subtitle { font-size:14px !important; line-height:1.35 !important; color:#556579 !important; }
.applications-filter-toolbar { background:#FFFFFF !important; border:1px solid #E2E8F0 !important; border-radius:12px !important; padding:14px !important; gap:8px !important; margin-bottom:16px !important; }
.applications-filter-toolbar select,.applications-filter-toolbar input[type="date"],.applications-filter-toolbar .toolbar-search input { height:42px !important; font-size:12px !important; font-family:'Segoe UI',system-ui,-apple-system,sans-serif !important; }
.applications-filter-toolbar .toolbar-search input::placeholder { font-size:12px !important; }
.applications-filter-toolbar .btn { height:42px !important; font-size:11px !important; }
.applications-summary { grid-template-columns:repeat(4,minmax(0,1fr)) !important; gap:14px !important; margin-bottom:18px !important; }
.applications-summary .summary-card { min-height:46px !important; height:46px !important; padding:12px 18px !important; box-sizing:border-box; border:1px solid #E2E8F0 !important; border-radius:12px !important; }
.applications-summary .summary-card span { font-size:12px !important; font-weight:700 !important; color:#556579 !important; }
.applications-summary .summary-card strong { font-size:14px !important; font-weight:700 !important; color:#071B4D !important; }
.applications-card { background:#FFFFFF !important; border:1px solid #E2E8F0 !important; border-radius:14px !important; overflow:hidden !important; }
.applications-table { width:100% !important; min-width:0 !important; table-layout:fixed !important; border-collapse:collapse !important; border:1px solid #1F1F1F !important; }
.applications-table th:nth-child(1),.applications-table td:nth-child(1){width:13% !important}.applications-table th:nth-child(2),.applications-table td:nth-child(2){width:17% !important}.applications-table th:nth-child(3),.applications-table td:nth-child(3){width:19% !important}.applications-table th:nth-child(4),.applications-table td:nth-child(4){width:19% !important}.applications-table th:nth-child(5),.applications-table td:nth-child(5){width:8% !important}.applications-table th:nth-child(6),.applications-table td:nth-child(6){width:8% !important}.applications-table th:nth-child(7),.applications-table td:nth-child(7){width:8% !important}.applications-table th:nth-child(8),.applications-table td:nth-child(8){width:8% !important}
.applications-table thead th { background:#C7DDF2 !important; color:#0B2A5B !important; font-family:'Segoe UI',system-ui,-apple-system,sans-serif !important; font-size:13px !important; font-weight:700 !important; letter-spacing:0 !important; text-transform:none !important; text-align:left !important; padding:9px 10px !important; line-height:1.1 !important; white-space:nowrap !important; border-top:2px solid #B8C1CC !important; border-bottom:2px solid #B8C1CC !important; border-right:1px solid #B8C1CC !important; }
.applications-table thead th:first-child{border-left:2px solid #B8C1CC !important}.applications-table thead th:last-child{border-right:2px solid #B8C1CC !important}
.applications-table tbody tr:nth-child(odd){background:#FFFFFF !important}.applications-table tbody tr:nth-child(even){background:#DDE2E8 !important}.applications-table tbody tr:hover{background:#E8F1FA !important}
.applications-table tbody td { font-family:'Segoe UI',system-ui,-apple-system,sans-serif !important; font-size:12px !important; color:#071B4D !important; padding:13px 10px !important; border-right:1px solid #B8C1CC !important; border-bottom:1px solid #B8C1CC !important; vertical-align:middle !important; white-space:normal !important; overflow-wrap:anywhere !important; }
.applications-table tbody td:first-child{border-left:2px solid #1F1F1F !important}.applications-table tbody td:last-child{border-right:2px solid #B8C1CC !important}.applications-table tbody tr:last-child td{border-bottom:2px solid #1F1F1F !important}
.applications-table .application-number-cell,.applications-table .job-title-cell,.applications-table .application-contact-cell{line-height:1.3 !important}
.applications-table .application-number-cell strong,.applications-table .job-title-cell strong{font-size:12px !important;font-weight:700 !important;color:#071B4D !important}
.applications-table .application-number-cell span,.applications-table .job-title-cell span,.applications-table .application-contact-cell span{display:block !important;font-size:11px !important;color:#556579 !important;line-height:1.25 !important}
.applications-table .status-pill{font-size:11px !important;line-height:1.2 !important;font-weight:600 !important;white-space:normal !important}
.applications-table td:last-child{text-align:right !important;white-space:nowrap !important}
.applications-table .application-view-button{display:inline-flex !important;align-items:center !important;justify-content:center !important;min-height:32px !important;height:32px !important;min-width:96px !important;padding:6px 10px !important;font-size:10px !important;border-radius:7px !important;white-space:nowrap !important}
.applications-pagination { display:grid !important; grid-template-columns:1fr auto 1fr !important; align-items:center !important; gap:12px !important; margin:0 !important; padding:16px 12px 2px !important; border:0 !important; background:#FFFFFF !important; font-size:12px !important; }
.applications-pagination button{height:32px !important;min-width:88px !important;padding:6px 10px !important;font-size:11px !important;border-radius:7px !important}.applications-pagination #applicationsPrev{justify-self:start}.applications-pagination #applicationsNext{justify-self:end}.applications-pagination #applicationsPageInfo{font-size:12px !important;font-weight:700 !important;color:#071B4D !important;white-space:nowrap !important}
@media (max-width:899px){.applications-filter-toolbar{grid-template-columns:repeat(2,minmax(0,1fr)) !important}.applications-filter-toolbar .toolbar-search{grid-column:1 / -1 !important}.applications-summary{grid-template-columns:repeat(3,minmax(0,1fr)) !important}}
@media (max-width:760px){.admin-main > .admin-container{width:calc(100% - 28px)}.applications-filter-toolbar{grid-template-columns:1fr !important}.applications-filter-toolbar .toolbar-search{grid-column:auto !important}.applications-summary{grid-template-columns:repeat(2,minmax(0,1fr)) !important}.applications-table thead th,.applications-table tbody td{padding-left:8px !important;padding-right:8px !important}.applications-pagination{grid-template-columns:1fr !important;justify-items:center !important;padding-top:12px !important}.applications-pagination #applicationsPrev,.applications-pagination #applicationsNext{justify-self:center !important}}
</style>
</head>
<body class="admin-app-page">
<header class="admin-header">
<div class="admin-container admin-nav">
<a aria-label="Back to Navodix website" class="admin-brand" href="../index.html">
<img alt="Navodix IT Solutions" src="../assets/images/logo.png?v=17"/>
</a>
<nav aria-label="Admin main menu" class="admin-main-nav">
<a class="admin-main-nav-link active" href="recruitment.html?v=17">Recruitment</a>
<span class="admin-main-nav-link disabled">Employee Management</span>
</nav>
<div class="admin-nav-right">
<span class="admin-user" id="adminUser"></span>
<button class="btn btn-outline" id="logoutButton" type="button">
<i aria-hidden="true" class="fa-solid fa-right-from-bracket"></i> Sign Out
        </button>
</div>
</div>
</header>
<nav aria-label="Manage Requirements sections" class="admin-section-nav">
<div class="admin-container admin-section-nav-inner">
<a class="admin-section-nav-link" href="recruitment.html?v=17">Manage Requirements</a><a class="admin-section-nav-link" href="profiles.html?v=1">Profiles Management</a>
<a class="admin-section-nav-link active" href="applications.html?v=17">Applications</a>
<details class="admin-section-nav-dropdown">
<summary class="admin-section-nav-link">Master Data</summary>
<div class="master-data-menu" role="menu">
<a href="clients.html?v=17" role="menuitem">Clients</a>
<a href="job-categories.html?v=17" role="menuitem">Job Categories</a>
<a href="locations.html?v=17" role="menuitem">Locations</a><a href="projects-areas.html?v=30" role="menuitem">Projects / Areas</a><a href="action-item-assignees.html?v=30" role="menuitem">Action Item Assignees</a>
</div>
</details>
<a class="admin-section-nav-link" href="user-management.html?v=17">User Management</a>
      <a class="admin-section-nav-link" href="action-items.html?v=30">Action Items</a>
</div>
</nav>
<main class="admin-main">
<div class="admin-container">
<div class="admin-page-heading jobs-heading">
<div class="jobs-heading-text">
<h1>Applications</h1>
<span class="jobs-heading-subtitle">View and manage submitted career applications</span>
</div>
</div>
<section aria-label="Application filters" class="jobs-toolbar applications-toolbar applications-filter-toolbar">
<div class="toolbar-search">
<i aria-hidden="true" class="fa-solid fa-magnifying-glass"></i>
<input id="applicationSearch" placeholder="Search by application number, applicant, email or requirement" type="search"/>
</div>
<select aria-label="Filter by application status" id="applicationStatusFilter">
<option value="">All Statuses</option>
<option value="new">New</option>
<option value="under_review">Under Review</option>
<option value="shortlisted">Shortlisted</option>
<option value="submitted_to_client">Submitted to Client</option>
<option value="interviewing">Interviewing</option>
<option value="selected">Selected</option>
<option value="offer_sent">Offer Sent</option>
<option value="joined">Joined</option>
<option value="on_hold">On Hold</option>
<option value="future_consideration">Future Consideration</option>
<option value="rejected">Rejected</option>
<option value="withdrawn">Withdrawn</option>
</select>
<select aria-label="Filter by client" id="applicationClientFilter">
<option value="">All Clients</option>
</select>
<select aria-label="Filter by requirement" id="applicationJobFilter">
<option value="">All Requirements</option>
</select>
<select aria-label="Filter by requirement category" id="applicationCategoryFilter">
<option value="">All Job Categories</option>
</select>
<select aria-label="Filter by location" id="applicationLocationFilter">
<option value="">All Locations</option>
</select>
<div aria-label="Application date range" class="applications-date-filter">
<label for="applicationDateFrom">From</label>
<input aria-label="Application date from" id="applicationDateFrom" type="date"/>
<label for="applicationDateTo">To</label>
<input aria-label="Application date to" id="applicationDateTo" type="date"/>
</div>
<select aria-label="Filter by interview result" id="applicationInterviewResultFilter">
<option value="">All Interview Results</option>
<option value="pending">Pending</option>
<option value="passed">Passed</option>
<option value="failed">Failed</option>
<option value="cancelled">Cancelled</option>
<option value="rescheduled">Rescheduled</option>
<option value="no_show">No Show</option>
</select>
<select aria-label="Filter submitted to client" id="applicationSubmittedClientFilter">
<option value="">Submitted to Client: All</option>
<option value="yes">Submitted to Client: Yes</option>
<option value="no">Submitted to Client: No</option>
</select>
<select aria-label="Filter future consideration" id="applicationFutureConsiderationFilter">
<option value="">Future Consideration: All</option>
<option value="yes">Future Consideration: Yes</option>
<option value="no">Future Consideration: No</option>
</select>
<button class="btn btn-outline" id="clearApplicationFiltersButton" type="button">Clear Filters</button>
<button class="btn btn-outline" id="refreshApplicationsButton" type="button">
<i aria-hidden="true" class="fa-solid fa-rotate"></i> Refresh
        </button>
</section>
<div aria-live="polite" class="admin-message" id="applicationsMessage" role="status"></div>
<section aria-label="Application summary" class="jobs-summary applications-summary">
<div class="summary-card"><span>Total Applications</span><strong id="totalApplications">0</strong></div>
<div class="summary-card"><span>New</span><strong id="newApplications">0</strong></div>
<div class="summary-card"><span>Under Review</span><strong id="underReviewApplications">0</strong></div>
<div class="summary-card"><span>Shortlisted</span><strong id="shortlistedApplications">0</strong></div>
</section>
<section class="jobs-card applications-card">
<div class="table-wrap">
<table class="jobs-table applications-table">
<thead>
<tr>
<th>Application</th>
<th>Applicant</th>
<th>Requirement</th>
<th>Contact</th>
<th>Experience</th>
<th>Applied</th>
<th>Status</th>
<th>Action</th>
</tr>
</thead>
<tbody id="applicationsTableBody"></tbody>
</table>
</div>
<div class="empty-state hidden" id="emptyApplications">
<i aria-hidden="true" class="fa-solid fa-file-circle-xmark"></i>
<h3>No applications found</h3>
<p>Submitted career applications will appear here.</p>
</div>
<div aria-label="Applications pagination" class="applications-pagination" id="applicationsPagination">
<button class="btn btn-outline btn-small" id="applicationsPrev" type="button"><i aria-hidden="true" class="fa-solid fa-chevron-left"></i> Previous</button>
<span id="applicationsPageInfo">Page 1 of 1</span>
<button class="btn btn-outline btn-small" id="applicationsNext" type="button">Next <i aria-hidden="true" class="fa-solid fa-chevron-right"></i></button>
</div>
</section>

</div>
</main>
<div aria-hidden="true" class="modal-backdrop hidden" id="applicationModal">
<div aria-labelledby="applicationModalTitle" aria-modal="true" class="job-modal application-modal" role="dialog">
<div class="modal-header application-details-modal-header">
<div class="application-modal-title-wrap">
<h2 id="applicationModalTitle">Application Details</h2>
<p class="application-modal-number" id="applicationModalNumber">View complete application information</p>
</div>
<div class="application-modal-header-status" aria-label="Application status">
<span id="applicationModalStatus">New</span>
</div>
<button aria-label="Close" class="modal-close" id="closeApplicationModal" type="button">
<i aria-hidden="true" class="fa-solid fa-xmark"></i>
</button>
</div>
<div class="application-modal-body">
<div aria-live="polite" class="admin-message" id="applicationModalMessage" role="status"></div>









<section class="application-detail-section">
<div class="application-detail-heading"><h3>Application &amp; Requirement</h3></div>
<div class="application-detail-grid" id="applicationJobDetails"></div>
</section><section class="application-detail-section">
<div class="application-detail-heading"><h3>Applicant Information</h3></div>
<div class="application-detail-grid" id="applicationApplicantDetails"></div>
</section><section class="application-detail-section">
<div class="application-detail-heading"><h3>Education &amp; Skills</h3></div>
<div class="application-detail-grid" id="applicationEducationDetails"></div>
</section><section class="application-detail-section">
<div class="application-detail-heading"><h3>Application Information</h3></div>
<div class="application-detail-grid" id="applicationApplicationDetails"></div>
<div class="application-long-fields-grid"><div class="application-long-field"><span>Cover Message</span><p id="applicationCoverMessage">—</p></div><div class="application-long-field"><span>Additional Information</span><p id="applicationAdditionalInformation">—</p></div></div></section><section class="application-detail-section application-interviews-section">
<div class="application-detail-heading application-interviews-heading">
<div><h3>Interview Rounds</h3></div>
<button class="btn btn-primary btn-small" id="addInterviewRoundButton" type="button">Add Interview</button>
</div>
<div class="application-interviews-list" id="applicationInterviewsList">
<div class="application-interviews-empty">No interview rounds have been added.</div>
</div>
</section><section class="application-detail-section application-activity-section application-updates-notes-section">
<div class="application-detail-heading application-activity-heading">
<div><h3>Updates / Notes History</h3></div>
<button class="btn btn-primary btn-small" id="addApplicationNoteButton" type="button">Add Note</button>
</div>
<div class="application-activity-list" id="applicationNotesHistoryList">
<div class="application-activity-empty">Loading notes history…</div>
</div>
</section><section class="application-detail-section application-activity-section application-status-history-section">
<div class="application-detail-heading application-activity-heading">
<div><h3>Application Status History</h3></div>
</div>
<div class="application-activity-list" id="applicationStatusHistoryList">
<div class="application-activity-empty">Loading status history…</div>
</div>
</section><section class="application-detail-section application-status-section">
<div class="application-detail-heading application-status-heading">
<div><h3>Application Status</h3></div>
</div>
<div class="application-status-form">
<div class="application-form-field">
<label for="applicationStatusSelect">Status</label>
<select id="applicationStatusSelect">
<option value="new">New</option>
<option value="under_review">Under Review</option>
<option value="shortlisted">Shortlisted</option>
<option value="submitted_to_client">Submitted to Client</option>
<option value="interviewing">Interviewing</option>
<option value="selected">Selected</option>
<option value="offer_sent">Offer Sent</option>
<option value="joined">Joined</option>
<option value="on_hold">On Hold</option>
<option value="future_consideration">Future Consideration</option>
<option value="rejected">Rejected</option>
<option value="withdrawn">Withdrawn</option>
</select>
</div>
<div class="application-form-field application-form-field-wide">
<label for="applicationStatusNote">Status Change Note <span>(optional)</span></label>
<input id="applicationStatusNote" maxlength="5000" placeholder="Enter a note about this status change" type="text"/>
</div>
<button class="btn btn-primary btn-small application-status-save-inline" id="saveApplicationStatusButton" type="button">Save Status</button>
</div>
<div aria-live="polite" class="admin-message" id="applicationStatusMessage" role="status"></div>
</section><section class="application-detail-section application-contact-section">
<div class="application-detail-heading"><h3>Contact &amp; Resume</h3></div>
<div class="application-detail-grid" id="applicationContactDetails"></div>
<div class="application-resume-status" id="applicationResumeStatus">Resume is securely stored in Careers Admin.</div>
</section>
<div class="application-modal-footer-actions">
<button aria-disabled="true" class="btn btn-outline" id="applicationDownloadResumeButton" type="button">Download Resume</button>
<button aria-disabled="true" class="btn btn-outline" id="applicationResumeButton" type="button">Open Resume</button>
<button class="btn btn-outline" id="applicationModalCloseBtn" type="button">Close</button>
</div>
</div>
</div>
</div>

<!-- Add/Edit Interview Round popup -->
<div aria-hidden="true" class="modal-backdrop hidden application-child-modal" id="interviewRoundModal">
<div aria-labelledby="interviewRoundModalTitle" aria-modal="true" class="job-modal application-child-modal-dialog" role="dialog">
<div class="modal-header application-child-modal-header">
<div>
<h2 id="interviewRoundModalTitle">Add Interview Round</h2>
<p id="interviewRoundModalNumber">Interview details</p>
</div>
<button aria-label="Close" class="modal-close" id="closeInterviewRoundModal" type="button"><i aria-hidden="true" class="fa-solid fa-xmark"></i></button>
</div>
<form class="application-child-modal-body" id="addInterviewRoundForm" novalidate>
<div class="application-interview-form-grid">
<div class="application-form-field"><label for="interviewType">Interview Type <span>*</span></label><select id="interviewType" required><option value="">Select type</option><option value="technical">Technical</option><option value="hr">HR</option><option value="managerial">Managerial</option><option value="client">Client</option><option value="other">Other</option></select></div>
<div class="application-form-field"><label for="interviewResult">Result <span>*</span></label><select id="interviewResult" required><option value="pending">Pending</option><option value="passed">Passed</option><option value="failed">Failed</option><option value="cancelled">Cancelled</option><option value="rescheduled">Rescheduled</option><option value="no_show">No Show</option></select></div>
<div class="application-form-field"><label for="interviewDate">Scheduled Date <span>*</span></label><input id="interviewDate" required type="date"></div>
<div class="application-form-field"><label for="interviewTime">Scheduled Time</label><input id="interviewTime" type="time"></div>
<div class="application-form-field"><label for="interviewer">Interviewer <span>*</span></label><input id="interviewer" maxlength="150" placeholder="Enter interviewer name" required type="text"></div>
<div class="application-form-field"><label for="interviewMode">Mode <span>*</span></label><select id="interviewMode" required><option value="online">Online</option><option value="in_person">In Person</option><option value="phone">Phone</option></select></div>
<div class="application-form-field application-form-field-wide"><label for="interviewFeedback">Feedback / Notes</label><textarea id="interviewFeedback" maxlength="5000" placeholder="Enter interview feedback or notes" rows="4"></textarea></div>
</div>
<div aria-live="polite" class="admin-message" id="interviewFormMessage" role="status"></div>
<div class="application-child-modal-actions"><button class="btn btn-outline btn-small" id="cancelInterviewRoundButton" type="button">Cancel</button><button class="btn btn-primary btn-small" id="saveInterviewRoundButton" type="submit">Save Interview Round</button></div>
</form>
</div>
</div>

<!-- Add Note popup -->
<div aria-hidden="true" class="modal-backdrop hidden application-child-modal" id="applicationNoteModal">
<div aria-labelledby="applicationNoteModalTitle" aria-modal="true" class="job-modal application-child-modal-dialog application-note-modal-dialog" role="dialog">
<div class="modal-header application-child-modal-header">
<div><h2 id="applicationNoteModalTitle">Add Note</h2><p>Application activity note</p></div>
<button aria-label="Close" class="modal-close" id="closeApplicationNoteModal" type="button"><i aria-hidden="true" class="fa-solid fa-xmark"></i></button>
</div>
<form class="application-child-modal-body" id="applicationNoteForm" novalidate>
<div class="application-form-field"><label for="applicationNote">Note <span>*</span></label><textarea id="applicationNote" maxlength="5000" placeholder="Enter your note here…" rows="5"></textarea><div class="application-note-counter" id="applicationNoteCounter">0 / 5000</div></div>
<div aria-live="polite" class="admin-message" id="applicationNoteMessage" role="status"></div>
<div class="application-child-modal-actions"><button class="btn btn-outline btn-small" id="cancelApplicationNoteButton" type="button">Cancel</button><button class="btn btn-primary btn-small" id="saveApplicationNoteButton" type="submit">Save Note</button></div>
</form>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/docx-preview@0.4.0/dist/docx-preview.min.js"></script>
<script src="js/config.js?v=17"></script>
<script src="js/supabase-client.js?v=17"></script>
<script src="js/auth.js?v=17"></script>
<script src="js/applications.js?v=32"></script>
<script src="js/navigation.js?v=33"></script>
</body>
</html>
